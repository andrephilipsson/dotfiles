# Keep Git off the interactive path: only the background worker scans files.
autoload -Uz add-zsh-hook
zmodload zsh/system
zmodload zsh/datetime
_prompt_refresh=1

_prompt_preexec() {
  _prompt_refresh=1
  _prompt_started=$EPOCHREALTIME
}

_prompt_git_result() {
  local fd=$1 result
  if [[ -z $2 || $2 == hup ]]; then
    IFS= read -r -u $fd result
  fi
  zle -F $fd
  exec {fd}<&-
  _prompt_fd=0
  _prompt_pid=''

  # Branch names can contain %, which must not become prompt escapes.
  _prompt_git=${result//\%/%%}
  [[ -n $_prompt_git ]] && _prompt_git="%F{244}${_prompt_git}%f "
  PROMPT="%F{blue}%B%~%b%f${_prompt_status} ${_prompt_git}${_prompt_mark}"
  zle reset-prompt
}

_prompt_precmd() {
  local exit_status=$?
  RPROMPT=''
  if [[ -n $_prompt_started ]]; then
    local -F elapsed=$(( EPOCHREALTIME - _prompt_started ))
    unset _prompt_started
    if (( elapsed > 1 )); then
      local -i seconds=$elapsed
      local duration=''
      if (( seconds >= 86400 )); then
        duration+="$(( seconds / 86400 ))d "
        (( seconds %= 86400 ))
      fi
      if (( seconds >= 3600 )); then
        duration+="$(( seconds / 3600 ))h "
        (( seconds %= 3600 ))
      fi
      if (( seconds >= 60 )); then
        duration+="$(( seconds / 60 ))m "
        (( seconds %= 60 ))
      fi
      RPROMPT="%F{244}${duration}${seconds}s%f"
    fi
  fi
  # Save the exit status so an asynchronous Git redraw cannot clear the
  # failure indicator.
  _prompt_status='%F{yellow}%B%(1j.*.)'
  (( exit_status )) && _prompt_status+='!'
  _prompt_status+='%b%f'
  _prompt_mark='%B%F{red}❯%f%b '

  # Empty Enter needs only the cached prompt, not another process or handshake.
  if (( ! _prompt_refresh )) && [[ $_prompt_directory == $PWD ]]; then
    PROMPT="%F{blue}%B%~%b%f${_prompt_status} ${_prompt_git}${_prompt_mark}"
    return 0
  fi
  _prompt_refresh=0

  # Discard pending work before starting a check for this prompt/directory.
  if (( _prompt_fd )); then
    zle -F $_prompt_fd
    exec {_prompt_fd}<&-
    _prompt_fd=0
    if [[ -o monitor ]]; then
      kill -TERM -- -$_prompt_pid 2>/dev/null
    else
      kill -TERM -- $_prompt_pid 2>/dev/null
    fi
    _prompt_pid=''
  fi

  # Keep the last result during refresh, but never carry it to another directory.
  if [[ $_prompt_directory != $PWD ]]; then
    _prompt_git=''
    _prompt_directory=$PWD
  fi
  PROMPT="%F{blue}%B%~%b%f${_prompt_status} ${_prompt_git}${_prompt_mark}"

  exec {_prompt_fd}< <(
    print -r -- $sysparams[pid]
    local output line branch oid dirty
    output=$(command git --no-optional-locks status --porcelain=v2 --branch --no-ahead-behind --untracked-files=normal 2>/dev/null)
    for line in ${(f)output}; do
      case $line in
        '# branch.head '*) branch=${line#\# branch.head } ;;
        '# branch.oid '*) oid=${line#\# branch.oid } ;;
        '# '*) ;;
        *) dirty=' ●' ;;
      esac
    done
    [[ $branch == '(detached)' ]] && branch=${oid[1,7]}
    print -r -- "${branch}${dirty}"
  )
  # This handshake precedes Git; it never waits for the repository scan.
  read -r _prompt_pid <&$_prompt_fd
  zle -F $_prompt_fd _prompt_git_result
}

add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd _prompt_precmd
