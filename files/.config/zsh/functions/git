#!/usr/bin/env zsh

# No arguments: status. `root`: change directory on a terminal, otherwise print
# the root. `root COMMAND...`: evaluate a command at the root without changing
# the caller's directory.
if (( $# == 0 )); then
  command git status
elif [[ $1 == root ]]; then
  shift
  local root

  if [[ $(command git rev-parse --is-inside-git-dir 2>/dev/null) == true ]]; then
    if [[ $(command git rev-parse --is-bare-repository) == true ]]; then
      root=$(command git rev-parse --absolute-git-dir)
    else
      # Inside .git, assume the working tree is its parent directory.
      root="$(command git rev-parse --git-dir)/.."
    fi
  else
    root=$(command git rev-parse --show-superproject-working-tree 2>/dev/null) || root=''
    if [[ -z $root ]]; then
      root=$(command git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
    fi
  fi
  root=${root:-$PWD}

  if (( $# == 0 )); then
    if [[ -t 1 ]]; then
      builtin cd -- "$root"
    else
      print -r -- "$root"
    fi
  else
    (builtin cd -- "$root" && eval "$*")
  fi
else
  command git "$@"
fi
