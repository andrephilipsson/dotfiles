{
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard"
  },
  "reveal_if_open": false,
  "disable_ai": true,
  "project_panel": {
    "entry_spacing": "standard",
    "dock": "left"
  },
  "outline_panel": {
    "button": true,
    "dock": "right"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "buffer_line_height": "standard",
  "buffer_font_size": 14.0,
  "buffer_font_family": "Berkeley Mono",
  "markdown_preview": {
    "font_size": 14.0,
    "code_font_family": "Berkeley Mono"
  },
  "ui_font_size": 14.0,
  "ui_font_family": "Berkeley Mono",
  "terminal": {
    "font_size": 14.0,
    "font_family": "Berkeley Mono"
  }
}
