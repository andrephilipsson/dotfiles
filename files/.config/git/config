[user]
	name = André Philipsson
	email = andre@philipsson.me
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMvdouuejuxabTf0R41rIhPcJcVmJvRzxfwDKnVD7IWd

[includeIf "gitdir:~/Developer/vetyfinder/"]
    path = ~/.config/git/config-vetyfinder

[init]
	defaultBranch = main

[pull]
	ff = only

[pager]
	status = true

[log]
	decorate = short

[alias]
	ci = commit
	co = checkout
	last = log -1 HEAD
	st = status
	update = pull --rebase origin
	nah = "!f(){ git reset --hard; git clean -df; if [ -d ".git/rebase-apply" ] || [ -d ".git/rebase-merge" ]; then git rebase --abort; fi; }; f"

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[merge]
	conflictStyle = zdiff3

[push]
	autoSetupRemote = true

[rebase]
	autosquash = true
	updateRefs = true

[advice]
	skippedCherryPicks = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
